/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a full size pipeline test.

    Use as follows:
        nextflow run nf-core/funcprofiler -profile test_full,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

// rgi and metaphlan come from depot.galaxyproject.org, which is slow enough that the 20 min
// default kills the pull mid-download.
apptainer.pullTimeout   = '60m'
singularity.pullTimeout = '60m'

params {
    config_profile_name                    = 'Full test profile'
    config_profile_description             = 'Full test dataset to check pipeline function'
    input                                  = 'https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/taxprofiler/samplesheet_shortreadsonly.csv'
    databases                              = params.pipelines_testdata_base_path + 'funcprofiler/database_full.csv'
    run_fmhfunprofiler                     = true
    run_humann_v3                          = true
    run_rgi                                = true
    // mi-faser, DIAMOND and eggNOG-mapper are off because there is no full-size database for
    // them in `database_full.csv`: mi-faser ships its database inside the container rather than
    // as a downloadable full-size release, and the DIAMOND and eggNOG-mapper support is still
    // beta. Turn these on here once full-size databases are staged on S3.
    run_mifaser                            = false
    run_diamond                            = false
    run_eggnogmapper                       = false
    run_humann_v4                          = false
}
