graph LR
    %%metro line: reads | Reads | #2196F3
    %%metro line: db | Databases | #607D8B
    %%metro line: profiles | Profiles | #E91E63
    %%metro line: logs | Logs | #795548

    subgraph input[Input]
        input_short([Short Read\nFASTQ])
        input_dbs([Databases])
        merge(MERGE_RUNS)
    end

    subgraph profiling[Functional Profiling]
        humann(HUMAnN v3/v4)
        fmhfunprofiler(FMH FunProfiler)
        mifaser(mifaser)
        RGI(RGI)
        diamond(DIAMOND)
        eggnog_mapper(eggNOG-mapper)
    end

    subgraph Output[Output]
        multiqc(MultiQC)
        output([Results Directory])
    end

    %% Reads
    input_short -->|reads| merge
    merge -->|reads| humann
    merge -->|reads| fmhfunprofiler
    merge -->|reads| mifaser
    merge -->|reads| RGI
    merge -->|reads| diamond
    merge -->|reads| eggnog_mapper

    %% Databases
    input_dbs -->|db| humann
    input_dbs -->|db| fmhfunprofiler
    input_dbs -->|db| mifaser
    input_dbs -->|db| RGI
    input_dbs -->|db| diamond
    input_dbs -->|db| eggnog_mapper

    %% Profile tables
    humann -->|profiles| output
    fmhfunprofiler -->|profiles| output
    mifaser -->|profiles| output
    RGI -->|profiles| output
    diamond -->|profiles| output
    eggnog_mapper -->|profiles| output

    %% Reporting
    humann -->|logs| multiqc
    fmhfunprofiler -->|logs| multiqc
    mifaser -->|logs| multiqc
    RGI -->|logs| multiqc
    diamond -->|logs| multiqc
    eggnog_mapper -->|logs| multiqc
    multiqc -->|logs| output
